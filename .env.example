# Copy to .env.local. Never use a VITE_ prefix for secrets.
# Get a key from the domestic BigModel console; only glm-4.7-flash is called.
BIGMODEL_API_KEY=
# Optional: proxy for external public book libraries only; leave empty for direct access.
LIBRARY_PROXY_URL=

# Select bigmodel or bailian. Bailian uses qwen-flash in Beijing.
MODEL_PROVIDER=bailian
DASHSCOPE_API_KEY=
# Set true only after enabling qwen-flash free-quota-only in the Bailian console.
# This flag records your confirmation; the provider console switch prevents billing.
BAILIAN_FREE_QUOTA_CONFIRMED=false
# Enable only after the snapshot has its own free-quota-only switch enabled.
BAILIAN_FALLBACK_FREE_QUOTA_CONFIRMED=false
